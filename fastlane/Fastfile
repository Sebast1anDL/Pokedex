# fastlane/Fastfile — Pokédex App
# Documentación: https://docs.fastlane.tools

default_platform(:android)

platform :android do

  # ── Lane: test ────────────────────────────────────────────────────────────
  # Ejecuta los tests unitarios y de integración del proyecto Flutter.
  # Uso: fastlane test
  desc "Ejecuta los tests de Flutter"
  lane :test do
    sh("flutter test", log: true)
  end

  # ── Lane: build ───────────────────────────────────────────────────────────
  # Genera el APK de debug listo para instalar.
  # Uso: fastlane build
  desc "Genera el APK debug"
  lane :build do
    sh("flutter build apk --debug")
    UI.success("✅ APK generado en build/app/outputs/flutter-apk/app-debug.apk")
  end

  # ── Lane: release ─────────────────────────────────────────────────────────
  # Genera el APK de release optimizado.
  # Uso: fastlane release
  desc "Genera el APK release"
  lane :release do
    sh("flutter clean")
    sh("flutter pub get")
    sh("flutter build apk --release")
    UI.success("✅ APK release generado en build/app/outputs/flutter-apk/app-release.apk")
  end

  # ── Lane: ci ──────────────────────────────────────────────────────────────
  # Pipeline completo: tests + build release. Ideal para CI/CD.
  # Uso: fastlane ci
  desc "Pipeline CI: tests + build release"
  lane :ci do
    UI.message("🔍 Ejecutando análisis estático...")
    sh("flutter analyze")

    UI.message("🧪 Ejecutando tests...")
    sh("flutter test")

    UI.message("🏗️  Generando APK release...")
    sh("flutter clean")
    sh("flutter pub get")
    sh("flutter build apk --release")

    UI.success("✅ Pipeline CI completado exitosamente")
  end

end
